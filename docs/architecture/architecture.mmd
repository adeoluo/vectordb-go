flowchart LR
    classDef edge     fill:#F59E0B,stroke:#1E293B,color:#1E293B,stroke-width:1px;
    classDef core     fill:#6366F1,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef data     fill:#10B981,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef control  fill:#0EA5E9,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef obs      fill:#CBD5E1,stroke:#1E293B,color:#1E293B,stroke-width:1px;

    subgraph Interfaces["Interfaces (internal/server)"]
        direction TB
        CLI["vectordb CLI<br/>serve, bench, load"]:::edge
        Client(["HTTP client<br/>or vectordb load"]):::edge
        Router["HTTP handlers<br/>collections, vectors"]:::core
        Validate["Validation<br/>ids, dims, NaN/Inf"]:::control
        CLI ~~~ Client --> Router --> Validate
    end

    subgraph Core["Database core (internal/db)"]
        direction TB
        DB["DB<br/>collections, LOCK file"]:::core
        Collection["Collection<br/>log-ordered writes"]:::core
        Policy["Snapshot policy<br/>interval, WAL bytes"]:::control
        Recovery["Recovery<br/>snapshot + WAL replay"]:::control
        DB --> Collection
        Policy --> Collection
        Collection ~~~ Recovery
    end

    subgraph Storage["Index and durable state"]
        direction TB
        HNSW["HNSW graph<br/>link, tombstone, search"]:::core
        Distance["Distance kernels<br/>L2, cosine"]:::core
        WAL[("WAL segments<br/>CRC-32C, fsync")]:::data
        Snap[("Snapshots<br/>newest 2 kept")]:::data
        Meta[("meta.json<br/>dim, metric, M")]:::data
        Distance --> HNSW ~~~ WAL ~~~ Snap ~~~ Meta
    end

    subgraph Obs["Benchmarking and observability"]
        direction TB
        Dataset[("Datasets<br/>synthetic, fvecs/ivecs")]:::data
        Bench["Benchmark<br/>recall@k, QPS per ef"]:::obs
        Metrics["Route metrics<br/>Prometheus text"]:::obs
        Dataset --> Bench ~~~ Metrics
    end

    Interfaces -->|validated operations| Core
    Core -->|log, link, snapshot| Storage
    Interfaces -->|bench, request metrics| Obs
